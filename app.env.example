# =============================================================================
# DuckNet-Lite — 環境設定ファイル(任意のサンプル)
# -----------------------------------------------------------------------------
# このファイルを `app.env` という名前でスクリプトと同じ場所に置くと、
# run.sh / run.bat / run.ps1 が起動時に読み込みます(DUCKNET_ENV_FILE で場所変更可)。
#
# 形式: KEY=VALUE(1行1項目 / 行頭 # はコメント / = の前後に空白を入れない)。
# 本番では権限を絞り、機密を含む場合はリポジトリにコミットしないこと。
# =============================================================================

# --- ランチャ向け -----------------------------------------------------------
# 使う Python を明示(未設定なら .venv → python3/py → python の順に自動検出)
#DUCKNET_PYTHON=/usr/bin/python3.12

# --- 製品本体が参照する環境変数 --------------------------------------------
# (注) DUCKNET_OFFLINE は製品コードが読む設定ではありません。テスト実行時の
#      約束事として tests/run_all.py が設定するだけなので、ここでは指定不要です。

# コンソール文字コード(既定で UTF-8。通常は変更不要)
#PYTHONUTF8=1
#PYTHONIOENCODING=utf-8
