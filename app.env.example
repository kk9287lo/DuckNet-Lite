# =============================================================================
# DuckNet-Lite — 環境設定ファイル(任意のサンプル)
# -----------------------------------------------------------------------------
# このファイルを `app.env` という名前でスクリプトと同じ場所に置くと、起動時に読み込まれます
# (DUCKNET_ENV_FILE で場所変更可)。読み込みは製品本体(Python)が行うので、run.sh /
# run.bat / run.ps1 からの起動でも、GUI ランチャのダブルクリック起動でも同じように効きます。
# systemd へ登録した場合も生成される unit の EnvironmentFile= から読まれます。
#
# 優先順位: **起動時に指定した環境変数が常に勝ちます**(このファイルは既定値の提供)。
#   例) DUCKNET_LISTEN=7777 ./run.sh  → app.env の DUCKNET_LISTEN は無視されます。
#
# 形式: KEY=VALUE(1行1項目 / # で始まる行はコメント)。= の前後の空白、値を囲む
# 引用符、CRLF 改行は許容します。解釈できない行は黙って飛ばします(設定の書き間違いで
# ゲートウェイが起動しないのが最悪なので、読めるところだけ読みます)。
# 本番では権限を絞り、機密を含む場合はリポジトリにコミットしないこと。
# =============================================================================

# --- ランチャ向け -----------------------------------------------------------
# 使う Python を明示(未設定なら .venv → python3/py → python の順に自動検出)
#DUCKNET_PYTHON=/usr/bin/python3.12

# --- 製品本体が参照する環境変数 --------------------------------------------
# (注) DUCKNET_OFFLINE は製品コードが読む設定ではありません。テスト実行時の
#      約束事として tests/run_all.py が設定するだけなので、ここでは指定不要です。

# コンソール文字コード(既定で UTF-8。通常は変更不要)
#PYTHONUTF8=1
#PYTHONIOENCODING=utf-8
