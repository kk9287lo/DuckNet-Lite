# Send only runtime source and release notices to the builder. A build may use
# a remote daemon, so Dockerfile COPY restrictions alone do not protect local
# backups, logs, credentials, or mutable state in the build context.
**/*
!Dockerfile
!.dockerignore
!README.md
!LICENSE.txt
!THIRD_PARTY_NOTICES.txt
!sbom.cdx.json
!dataplane/
dataplane/*
!dataplane/__init__.py
!dataplane/__main__.py
!dataplane/admin.py
!dataplane/service.py
!dataplane/engine/
dataplane/engine/*
!dataplane/engine/__init__.py
!dataplane/engine/core/
dataplane/engine/core/*
!dataplane/engine/core/__init__.py
!dataplane/engine/core/accel.py
!dataplane/engine/core/atomic_io.py
!dataplane/engine/core/autostart.py
!dataplane/engine/core/commit_barrier.py
!dataplane/engine/core/i18n.py
!dataplane/engine/core/netaddr.py
!dataplane/engine/core/origin.py
!dataplane/engine/core/saferegex.py
!dataplane/engine/core/serving_lease.py
!dataplane/engine/core/signed_state.py
!dataplane/engine/lifeform/
dataplane/engine/lifeform/*
!dataplane/engine/lifeform/__init__.py
!dataplane/engine/lifeform/bloom.py
!dataplane/engine/lifeform/graphql.py
!dataplane/engine/lifeform/kb_common.py
!dataplane/engine/lifeform/monitor.py
!dataplane/engine/lifeform/netutil.py
!dataplane/engine/lifeform/pipeline.py
!dataplane/engine/lifeform/policy.py
!dataplane/engine/services/
dataplane/engine/services/*
!dataplane/engine/services/__init__.py
!dataplane/engine/services/banner.py
!dataplane/engine/services/edge_config.py
!dataplane/engine/services/proxy.py
!dataplane/gui/
dataplane/gui/*
!dataplane/gui/__init__.py
!dataplane/gui/__main__.py
!dataplane/gui/settings.py
!dataplane/gui/tray.py
!dataplane/gui/assets/
dataplane/gui/assets/*
!dataplane/gui/assets/DuckNet-off.ico
!dataplane/gui/assets/DuckNet.ico
!dataplane/gui/assets/DuckNet.png
